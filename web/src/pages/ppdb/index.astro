---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import { data } from "../../lib/tembolok";
import { tombolEmas, tombolPutih } from "../../lib/gaya";
import { DOKUMEN } from "@/lib/dokumen";
import { BATAS_UNGGAH } from "@/lib/unggah";
import { angka, belumTerisi, kePoin, persen, pesanTanyaPpdb, rupiah, tanggalPanjang, tautanWa } from "@/lib/format";
import { kataKeadaanPpdb } from "@/lib/ppdb";
import { IkonBendera, IkonFasilitas, IkonGuru, IkonPanahKanan, IkonSiswa, IkonWhatsapp } from "@/komponen/Ikon";
import type { Jurusan } from "@/lib/tipe";

/**
 * Ketentuan & Jadwal PPDB. Isi dan aturannya sama dengan
 * frontend/src/app/(publik)/ppdb/page.tsx: pos biaya yang belum ditetapkan
 * tetap tampil dan ditandai (bukan disembunyikan), alur bawaan dipakai
 * selama sekolah belum menulis alurnya sendiri, dan persyaratan tambahan
 * hanya muncul bila sudah diisi.
 *
 * Yang baru hanya keterangan waktu pada jadwal ("sudah lewat", "12 hari
 * lagi"), dan itu dihitung dari tanggal pada pengaturan — bukan dikarang.
 */
const KETERANGAN_JALUR: Record<string, { teks: string; ikon: typeof IkonSiswa }> = {
  Reguler: { teks: "Jalur umum berdasarkan nilai rapor dan kelengkapan berkas.", ikon: IkonSiswa },
  Prestasi: {
    teks: "Untuk calon peserta didik dengan prestasi akademik maupun non-akademik.",
    ikon: IkonBendera,
  },
  Afirmasi: {
    teks: "Untuk calon peserta didik dari keluarga berpenghasilan rendah atau penyandang disabilitas.",
    ikon: IkonGuru,
  },
  "Perpindahan Tugas Orang Tua": { teks: "Untuk anak yang orang tuanya berpindah tugas ke wilayah sekolah.", ikon: IkonFasilitas },
};
const ALUR_BAWAAN = [
  "Isi formulir pendaftaran online dan unggah dokumen yang diminta.",
  "Nomor registrasi diterbitkan seketika setelah formulir terkirim. Simpan nomor tersebut.",
  "Panitia memverifikasi kelengkapan dan kesesuaian berkas.",
  "Pantau hasil verifikasi lewat menu Cek Status memakai nomor registrasi dan tanggal lahir.",
  "Peserta yang diterima melakukan daftar ulang sesuai ketentuan sekolah.",
];

const [{ profil }, jurusan, biaya] = await Promise.all([
  data.profil(),
  data.jurusan().then((h) => h.data).catch((): Jurusan[] => []),
  data.biaya().catch(() => null),
]);
const p = profil.pengaturan;
// Nomor admin PPDB = pengaturan "whatsapp" (Nomor WhatsApp panitia).
const nomorAdmin = (p.whatsapp ?? "").trim();
const chatAdmin = tautanWa(nomorAdmin, pesanTanyaPpdb(p.nama_sekolah ?? ""));
const ppdb = profil.ppdb;
const kataPpdb = kataKeadaanPpdb(ppdb, p);
const sisa = Math.max(ppdb.kuota - ppdb.terisi, 0);
const terisi = Math.min(persen(ppdb.terisi, ppdb.kuota), 100);
const alur = belumTerisi(p.ppdb_alur) ? [] : kePoin(p.ppdb_alur);
const syarat = belumTerisi(p.ppdb_syarat) ? [] : kePoin(p.ppdb_syarat);

// Keterangan waktu pada jadwal, dihitung terhadap hari ini.
const hariIni = new Date();
hariIni.setHours(0, 0, 0, 0);
const selisihHari = (teks?: string) => {
  if (!teks) return null;
  const t = new Date(teks.replace(" ", "T"));
  if (Number.isNaN(t.getTime())) return null;
  t.setHours(0, 0, 0, 0);
  return Math.round((t.getTime() - hariIni.getTime()) / 86_400_000);
};
const keteranganWaktu = (n: number | null) =>
  n === null ? null : n < 0 ? { teks: "Sudah lewat", lewat: true } : n === 0 ? { teks: "Hari ini", lewat: false } : { teks: `${angka(n)} hari lagi`, lewat: false };
const jadwal = [
  { k: "Pendaftaran dibuka", v: p.ppdb_mulai, ket: "Formulir online mulai dapat diisi." },
  { k: "Pendaftaran ditutup", v: p.ppdb_selesai, ket: "Batas akhir pengisian formulir dan unggah berkas." },
  { k: "Pengumuman hasil", v: p.ppdb_pengumuman, ket: "Hasil verifikasi dapat dilihat lewat menu Cek Status." },
]
  .filter((t) => t.v)
  .map((t) => ({ ...t, waktu: keteranganWaktu(selisihHari(t.v)) }));
// Tahap yang sedang berjalan: yang pertama belum lewat.
const indeksBerjalan = jadwal.findIndex((t) => t.waktu && !t.waktu.lewat);
---

<Publik sorotan judul="Informasi PPDB" deskripsi="Jadwal, persyaratan, jalur, dan alur pendaftaran peserta didik baru.">
  <KepalaHalaman
    pengaturan={p}
    judul={`PPDB Tahun Ajaran ${p.ppdb_tahun || ""}`.trim()}
    keterangan="Seluruh tahap pendaftaran dilakukan secara online. Bacalah persyaratan dan jadwal berikut sebelum mengisi formulir."
    induk="/ppdb"
    jalur="/ppdb"
    langkah="ketentuan"
    ppdbDibuka={ppdb.dibuka}
  >
    <div class="flex flex-wrap items-center gap-3">
      <span
        class={"inline-flex items-center justify-center gap-2 rounded-md px-3 py-2 text-xs leading-none font-bold tracking-[0.06em] text-white uppercase " +
          (kataPpdb.dibuka ? "bg-green-700" : "bg-slate-600")}
      >
        {kataPpdb.dibuka && <span class="h-2 w-2 animate-pulse rounded-full bg-white" aria-hidden="true" />}
        {kataPpdb.lencana}
      </span>
      {ppdb.dibuka && <a href="/ppdb/daftar" class={tombolEmas}>Isi Formulir Pendaftaran <IkonPanahKanan ukuran={15} /></a>}
      <a href="/ppdb/cek" class={"tombol-kilau " + tombolPutih}>Cek Status Pendaftaran</a>
    </div>
  </KepalaHalaman>

  <div class="wadah pt-10 pb-8">
    <!-- ================= Angka: satu baris, dibatasi garis ================= -->
    {
      ppdb.kuota > 0 && (
        <dl class="grid grid-cols-2 border-b border-garis lg:grid-cols-4" aria-label="Angka pendaftaran" data-muncul>
          {[
            { k: "Kuota keseluruhan", v: angka(ppdb.kuota) },
            { k: "Sudah mendaftar", v: angka(ppdb.terisi) },
            { k: "Sisa kuota", v: angka(sisa) },
            { k: "Kuota terisi", v: `${terisi}%` },
          ].map((a, i) => (
            <div class={"flex flex-col-reverse py-7 " + (i % 2 === 1 ? "border-l border-garis pl-6 " : "") + (i === 2 ? "border-t border-garis lg:border-t-0 " : "") + (i === 3 ? "border-t border-garis lg:border-t-0 " : "") + (i >= 1 ? "lg:border-l lg:pl-7 " : "")}>
              <dt class="mt-2 text-sm text-samar">{a.k}</dt>
              <dd class="text-5xl leading-none font-semibold tracking-tight text-biru-tua tabular-nums" data-hitung={a.v}>{a.v}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <!-- ================= Jadwal ================= -->
    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Waktu</p>
      <div>
        <h2 class="judul-bagian">Jadwal</h2>
        <ol>
          {jadwal.map((t, i) => {
            const berjalan = i === indeksBerjalan;
            return (
              <li class="grid gap-1 border-t border-garis py-5 last:border-b sm:grid-cols-[11rem_1fr_auto] sm:items-baseline sm:gap-6">
                <p class={"text-xl font-semibold tabular-nums " + (berjalan ? "text-biru-tua" : "text-teks")}>{tanggalPanjang(t.v)}</p>
                <div>
                  <p class="font-semibold text-biru-tua">{t.k}</p>
                  <p class="text-[15px] text-samar">{t.ket}</p>
                </div>
                {t.waktu && (
                  <p class={"text-sm " + (berjalan ? "font-semibold text-biru-tua" : "text-samar")}>
                    {berjalan && <span class="mr-2 inline-block h-2 w-2 rounded-full bg-emas align-middle" aria-hidden="true" />}
                    {t.waktu.teks}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
        {p.ppdb_biaya && <p class="mt-5 text-[15px] text-teks"><strong>Biaya pendaftaran:</strong> {p.ppdb_biaya}</p>}
        <div class="mt-8">
          {
            ppdb.dibuka ? (
              <a href="/ppdb/daftar" class={tombolEmas}>Daftar Sekarang <IkonPanahKanan ukuran={15} /></a>
            ) : (
              <p class="text-[15px] text-samar">
                Pendaftaran sedang ditutup. Yang sudah mendaftar tetap dapat memantau hasilnya di{" "}
                <a href="/ppdb/cek" class="font-semibold text-biru underline underline-offset-2">Cek Status</a>.
              </p>
            )
          }
        </div>
      </div>
    </section>

    <!-- ================= Alur ================= -->
    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Tahapan</p>
      <div>
        <h2 class="judul-bagian">Alur pendaftaran</h2>
        <ol>
          {(alur.length > 0 ? alur : ALUR_BAWAAN).map((a, i) => (
            <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-t border-garis py-5 last:border-b">
              <span class="text-4xl leading-none font-semibold text-emas tabular-nums">{i + 1}</span>
              <span class="pt-1 text-lg leading-snug">{a}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================= Dokumen ================= -->
    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Persyaratan</p>
      <div>
        <h2 class="judul-bagian">Dokumen yang diunggah</h2>
        <ul class="grid sm:grid-cols-2 sm:gap-x-12">
          {DOKUMEN.map((d) => (
            <li class="flex items-start justify-between gap-4 border-t border-garis py-4">
              <div>
                <p class="font-medium text-teks">{d.nama}</p>
                <p class="text-sm text-samar">{d.tipe}, maksimal {BATAS_UNGGAH}.{d.catatan ? ` ${d.catatan}` : ""}</p>
              </div>
              <span class={"inline-flex shrink-0 items-center justify-center rounded-md px-2.5 py-1.5 text-[11px] leading-none font-bold tracking-[0.06em] text-white uppercase " + (d.wajib ? "bg-red-700" : "bg-slate-600")}>{d.wajib ? "Wajib" : "Opsional"}</span>
            </li>
          ))}
        </ul>
        {
          syarat.length > 0 && (
            <div class="mt-8">
              <h3 class="text-base font-semibold text-biru-tua">Persyaratan tambahan</h3>
              <ul class="mt-3 space-y-2 text-[15px] leading-relaxed">
                {syarat.map((s) => (
                  <li class="flex gap-2.5"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-biru" aria-hidden="true" /><span>{s}</span></li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <!-- ================= Jalur ================= -->
    {
      ppdb.jalur.length > 0 && (
        <section class="bagian-polos" data-muncul>
          <p class="label-bagian">Pilihan</p>
          <div>
            <h2 class="judul-bagian">Jalur pendaftaran</h2>
            <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
              {ppdb.jalur.map((j) => (
                <div>
                  <h3 class="border-t-2 border-biru-tua pt-4 text-xl font-semibold text-biru-tua">{j}</h3>
                  {KETERANGAN_JALUR[j] && <p class="mt-2 text-[15px] leading-relaxed text-samar">{KETERANGAN_JALUR[j].teks}</p>}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ================= Kuota ================= -->
    {
      jurusan.length > 0 && (
        <section class="bagian-polos" data-muncul>
          <p class="label-bagian">Daya tampung</p>
          <div>
            <h2 class="judul-bagian">Kuota per peminatan</h2>
            <ul>
              {jurusan.map((j) => (
                <li class="grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-2 border-t border-garis py-4 last:border-b sm:grid-cols-[14rem_1fr_5rem]">
                  <span class="font-medium text-teks">{j.nama}</span>
                  <span class="text-right text-sm text-samar tabular-nums sm:order-3">{angka(j.pendaftar)} / {angka(j.kuota)}</span>
                  <span class="col-span-2 block h-[3px] bg-garis sm:col-span-1">
                    <span data-bilah class="block h-full bg-biru-tua" style={`width:${Math.min(persen(j.pendaftar, j.kuota), 100)}%`} />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ================= Biaya ================= -->
    {
      biaya && biaya.data.length > 0 && (
        <section class="bagian-polos" data-muncul>
          <p class="label-bagian">Biaya</p>
          <div class="min-w-0">
            <h2 class="judul-bagian">Rincian biaya</h2>
            {!biaya.lengkap && (
              <p class="mb-5 max-w-2xl text-[15px] leading-relaxed text-samar">
                Sebagian besaran biaya belum ditetapkan sekolah. Yang sudah tertera di bawah ini sudah final; yang bertanda belum ditetapkan akan diumumkan panitia.
              </p>
            )}
            <div class="overflow-x-auto">
              <table class="w-full min-w-[30rem] text-[15px]">
                <thead>
                  <tr class="text-left text-xs tracking-[0.12em] text-samar uppercase">
                    <th class="pb-3 font-semibold">Pos biaya</th>
                    <th class="pb-3 font-semibold">Tahap</th>
                    <th class="pb-3 text-right font-semibold">Jumlah</th>
                  </tr>
                </thead>
                <tbody>
                  {biaya.data.map((b) => (
                    <tr class="border-t border-garis">
                      <td class="py-4 pr-4">
                        <p class="font-medium text-teks">
                          {b.nama}
                          {!b.wajib && <span class="ml-2 text-xs font-normal text-samar">opsional</span>}
                        </p>
                        {b.keterangan && !belumTerisi(b.keterangan) && <p class="mt-0.5 text-sm leading-relaxed text-samar">{b.keterangan}</p>}
                      </td>
                      <td class="py-4 pr-4 text-samar">{b.tahap}</td>
                      <td class="py-4 text-right whitespace-nowrap">
                        {b.ditetapkan ? (
                          <>
                            <span class="font-semibold text-biru-tua tabular-nums">{rupiah(b.jumlah)}</span>
                            <span class="block text-xs text-samar">{b.satuan}</span>
                          </>
                        ) : (
                          <span class="text-sm text-samar">Belum ditetapkan</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
                {biaya.total_tahap.length > 0 && biaya.lengkap && (
                  <tfoot>
                    {biaya.total_tahap.map((t) => (
                      <tr class="border-t-2 border-biru-tua">
                        <td class="py-3 font-semibold text-teks" colspan="2">Total {t.tahap.toLowerCase()}</td>
                        <td class="py-3 text-right font-semibold text-biru-tua tabular-nums">{rupiah(t.total)}</td>
                      </tr>
                    ))}
                  </tfoot>
                )}
              </table>
            </div>
            {biaya.catatan && !belumTerisi(biaya.catatan) && <p class="mt-5 max-w-2xl text-sm leading-relaxed whitespace-pre-line text-samar">{biaya.catatan}</p>}
            <p class="mt-5 max-w-2xl text-sm leading-relaxed text-samar">
              Tidak ada biaya di luar daftar ini. Bila ada pihak yang meminta pembayaran lain atas nama sekolah, laporkan kepada panitia lewat halaman Kontak.
            </p>
          </div>
        </section>
      )
    }

    <!-- ================= Bantuan ================= -->
    <section class="bagian-polos !border-b-0" data-muncul>
      <p class="label-bagian">Bantuan</p>
      <div>
        <h2 class="judul-bagian">Masih ada pertanyaan?</h2>
        <p class="max-w-xl text-[15px] leading-relaxed text-samar">Jawaban seputar syarat, jadwal, dan biaya ada di Tanya Jawab. Bila belum terjawab, hubungi admin PPDB.</p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          {chatAdmin && (
            <a href={chatAdmin} target="_blank" rel="noopener noreferrer" class={tombolEmas}>
              <IkonWhatsapp ukuran={18} /> Chat admin PPDB
            </a>
          )}
          <a href="/faq" class={tombolPutih}>Tanya Jawab PPDB</a>
          <a href="/kontak" class={tombolPutih}>Hubungi Panitia</a>
        </div>
        {nomorAdmin && <p class="mt-4 text-sm text-samar">Admin PPDB: <strong class="text-teks tabular-nums">{nomorAdmin}</strong></p>}
      </div>
    </section>
  </div>
</Publik>
