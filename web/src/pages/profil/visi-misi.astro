---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import Orbit from "../../komponen/Orbit.astro";
import FotoProfil from "../../komponen/FotoProfil.astro";
import { data } from "../../lib/tembolok";
import { belumTerisi, kePoinTerisi } from "@/lib/format";
import { Menunggu, Naskah } from "@/komponen/Halaman";
import { IkonBersama, IkonGuru, IkonSiswa } from "@/komponen/Ikon";

/**
 * Visi & Misi. Susunan kartunya sama dengan versi Next — naskah di kolom
 * kiri, ilustrasi setinggi kartu di kolom kanan yang menempel tepi lewat
 * margin negatif, `object-contain object-bottom` supaya sosoknya utuh dan
 * duduk di dasar kartu. Alasan tiap angka ada di halaman Next-nya
 * (frontend/src/app/(publik)/profil/visi-misi/page.tsx).
 *
 * Keterangan ketiga peran menerangkan perannya secara umum, tanpa penilaian
 * tentang SMA IMTEK.
 */
const PELAKU = [
  {
    Ikon: IkonGuru,
    judul: "Guru dan tenaga kependidikan",
    keterangan:
      "Menyusun rencana pembelajaran, mengajar di kelas, membina kegiatan siswa, dan mengurus layanan administrasi sekolah.",
  },
  {
    Ikon: IkonSiswa,
    judul: "Siswa dan siswi",
    keterangan:
      "Yang menjalani prosesnya sehari-hari, dan yang pada akhirnya diukur hasil belajarnya beserta perkembangan karakternya.",
  },
  {
    Ikon: IkonBersama,
    judul: "Dikerjakan bersama",
    keterangan:
      "Rumusan di bawah ini menjadi acuan bersama. Perkembangan pelaksanaannya dapat diikuti pada halaman Berita dan Kesiswaan.",
  },
];

const { profil } = await data.profil();
const p = profil.pengaturan;
const misi = kePoinTerisi(p.misi);
const adaSemboyan = !belumTerisi(p.tagline ?? "");
// Tujuan dari SK visi misi (migrasi 043); bagiannya tidak tampil selama masih penanda.
const adaTujuan = !belumTerisi(p.tujuan ?? "");
const fotoVisiMisi = (p.foto_visi_misi ?? "").trim();
// Pembungkusnya yang meregang setinggi kartu; gambarnya menempel mutlak di
// dasar pembungkus. Meregangkan <img> langsung tidak andal: pada kartu yang
// teksnya lebih pendek daripada tetangganya, gambar berhenti di atas dasar.
const bungkus = "pointer-events-none relative -my-6 -mr-6 w-36 shrink-0 self-stretch sm:w-40 md:-my-7 md:-mr-7 md:w-48 xl:w-56";
const gambar = "absolute bottom-0 left-0 h-auto w-full transition duration-700 group-hover:scale-[1.03]";
---

<Publik sorotan judul="Visi & Misi" deskripsi="Arah yang dituju sekolah beserta langkah-langkah mencapainya.">
  <KepalaHalaman
    pengaturan={p}
    judul="Visi & Misi"
    keterangan="Visi adalah keadaan yang dituju sekolah; misi adalah langkah yang dikerjakan untuk mencapainya."
    induk="/profil"
    jalur="/profil/visi-misi"
  />

  <section class="relative py-12 md:py-16">
    <Orbit class="top-[12%] -left-[10%] h-[70%] w-[120%]" miring={-6} bintang={[{ x: 6, y: 55, ukuran: 14 }, { x: 94, y: 40, ukuran: 12 }]} />
    {/* Visi selebar penuh di atas, misi selebar penuh di bawahnya dengan
        poin dua kolom. Dulu keduanya berdampingan setinggi sama: dengan 13
        poin misi, kolom misi menjadi menara teks sempit dan kartu visi
        tersisa kosong setinggi itu pula. */}
    <div class="wadah relative space-y-8 lg:space-y-10">
      <section aria-labelledby="judul-visi" class="kaca group relative flex min-h-[15rem] gap-4 overflow-hidden border-l-4 !border-l-emas p-6 md:min-h-[17rem] md:gap-6 md:p-8" data-muncul>
        <div class="min-w-0 flex-1 self-center">
          <p class="text-xs font-bold tracking-[0.18em] text-biru uppercase">Arah</p>
          <h2 id="judul-visi" class="mt-1.5 text-2xl font-bold">Visi</h2>
          <span aria-hidden="true" class="mt-3 block h-1 w-12 rounded-full bg-emas"></span>
          {
            belumTerisi(p.visi) ? (
              <div class="mt-5"><Menunggu apa="Rumusan visi" polos /></div>
            ) : (
              <p class="mt-5 max-w-3xl text-xl leading-relaxed font-semibold text-biru-tua md:text-2xl">
                <span aria-hidden="true" class="mr-1 font-serif text-4xl leading-none text-emas">“</span>{p.visi}
              </p>
            )
          }
        </div>
        <div class={bungkus}>
          <img src="/ilustrasi/visi.png" alt="Ilustrasi guru dan tiga siswa di dalam kelas, di depan papan tulis" width="384" height="426" class={gambar} />
        </div>
      </section>

      <section aria-labelledby="judul-misi" class="kaca relative p-6 md:p-8" data-muncul="0.08">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-biru uppercase">Langkah</p>
            <h2 id="judul-misi" class="mt-1.5 text-2xl font-bold">Misi</h2>
            <span aria-hidden="true" class="mt-3 block h-1 w-12 rounded-full bg-emas"></span>
          </div>
          {misi.length > 0 && <p class="rounded-full bg-biru-muda px-3 py-1 text-xs font-bold text-biru tabular-nums">{misi.length} poin</p>}
        </div>
        {
          misi.length === 0 ? (
            <div class="mt-5"><Menunggu apa="Rumusan misi" polos /></div>
          ) : (
            <ol class="mt-6 grid gap-3 md:grid-cols-2">
              {misi.map((m, i) => (
                <li class="muncul-gulir flex gap-3 rounded-xl border border-garis bg-white/70 p-4 transition duration-300 hover:-translate-y-0.5 hover:border-biru/30 hover:bg-white hover:shadow-md">
                  <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-biru-tua text-xs font-bold text-white tabular-nums">{i + 1}</span>
                  <span class="text-[15px] leading-relaxed text-teks">{m}</span>
                </li>
              ))}
            </ol>
          )
        }
      </section>
    </div>
  </section>

  {
    adaTujuan && (
      <section class="wadah pb-12" aria-labelledby="judul-tujuan" data-muncul>
        <div class="kaca p-6 md:p-7">
          <p class="text-xs font-bold tracking-[0.18em] text-biru uppercase">Sasaran</p>
          <h2 id="judul-tujuan" class="mt-1.5 text-2xl font-bold">Tujuan</h2>
          <span aria-hidden="true" class="mt-3 block h-1 w-12 rounded-full bg-emas"></span>
          <div class="mt-5"><Naskah isi={p.tujuan} /></div>
        </div>
      </section>
    )
  }

  <section class="wadah pb-8" aria-labelledby="judul-pelaku" data-muncul>
    <h2 id="judul-pelaku" class="text-xs font-bold tracking-[0.18em] text-biru uppercase">Yang Menjalankannya</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        PELAKU.map((pel, i) => (
          <div data-muncul={String(i * 0.07)} class="flex h-full gap-4 border-t border-garis pt-5">
            <span aria-hidden="true" class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-biru-muda text-biru">
              <pel.Ikon ukuran={26} />
            </span>
            <div class="min-w-0">
              <h3 class="text-base leading-snug">{pel.judul}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-samar">{pel.keterangan}</p>
            </div>
          </div>
        ))
      }
    </div>
    {
      adaSemboyan && (
        <p class="mt-5 text-sm leading-relaxed text-samar">
          Semboyan yang dipakai sekolah: <span class="font-tangan text-xl font-semibold text-biru-tua">{p.tagline}</span>
        </p>
      )
    }
  </section>

  {fotoVisiMisi && <FotoProfil foto={fotoVisiMisi} judul="Foto visi dan misi" alt="Foto visi dan misi sekolah" />}
</Publik>
