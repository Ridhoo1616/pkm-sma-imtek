---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import Orbit from "../../komponen/Orbit.astro";
import { data } from "../../lib/tembolok";
import { belumTerisi, bagianNaskah } from "@/lib/format";
import { Menunggu, Naskah } from "@/komponen/Halaman";

const { profil } = await data.profil();
const p = profil.pengaturan;
const ada = !belumTerisi(p.sejarah);
// Naskah yang memakai judul "## " mendapat daftar isi di sampingnya.
const bagian = ada ? bagianNaskah(p.sejarah).bagian : [];
---

<Publik sorotan judul="Sejarah Sekolah" deskripsi="Riwayat berdirinya sekolah sampai keadaannya sekarang.">
  <KepalaHalaman
    pengaturan={p}
    judul="Sejarah Sekolah"
    keterangan="Riwayat singkat berdirinya sekolah, perkembangannya, dan keadaannya sekarang."
    induk="/profil"
    jalur="/profil/sejarah"
  />

  <section class="relative py-12 md:py-16">
    <Orbit class="top-[5%] -right-[25%] h-[70%] w-[90%]" miring={14} bintang={[{ x: 18, y: 60, ukuran: 14 }]} />
    <div class={"wadah relative grid gap-8 " + (bagian.length > 1 ? "lg:grid-cols-[1fr_16rem]" : "")}>
      <div class="max-w-3xl" data-muncul>
        {
          ada ? (
            <article class="kaca p-6 md:p-10">
              <Naskah isi={p.sejarah} />
            </article>
          ) : (
            <div class="kaca p-6 md:p-8">
              <Menunggu apa="Naskah sejarah sekolah" polos />
            </div>
          )
        }
      </div>
      {
        bagian.length > 1 && (
          <nav aria-label="Daftar isi" class="kaca h-fit p-5 lg:sticky lg:top-28" data-muncul="0.1">
            <p class="text-xs font-bold tracking-[0.14em] text-biru uppercase">Daftar isi</p>
            <ol class="mt-3 space-y-1">
              {bagian.map((b, i) => (
                <li>
                  <a href={`#${b.id}`} class="flex gap-2 rounded-lg px-2 py-1.5 text-sm text-teks transition hover:bg-biru-muda hover:text-biru">
                    <span class="font-bold text-samar tabular-nums">{i + 1}.</span>
                    {b.judul}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
  </section>
</Publik>
