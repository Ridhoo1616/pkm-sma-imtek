---
import { gambar, srcsetGambar } from "../../lib/gambar";
import Publik from "../../tata/Publik.astro";
import Orbit from "../../komponen/Orbit.astro";
import { data } from "../../lib/tembolok";
import { api, GalatApi } from "@/lib/api";
import { angka, keParagraf, tanggalPanjang } from "@/lib/format";
import { kelasKartuAkhir } from "@/komponen/Bagian";
import { IkonNaskah, IkonPanahKanan } from "@/komponen/Ikon";
import { tombolEmas, tombolGelap } from "../../lib/gaya";

/**
 * Detail berita. TIDAK memakai tembolok: backend menambah hitungan "dibaca"
 * pada setiap permintaan detail, dan tembolok akan membuat hitungan itu
 * meleset. Isi berita ditampilkan sebagai teks, bukan HTML, jadi naskah dari
 * basis data tidak dapat menyisipkan skrip.
 */
const slug = Astro.params.slug ?? "";
const [{ profil }, hasil] = await Promise.all([
  data.profil(),
  api.beritaDetail(slug).catch((e) => {
    if (e instanceof GalatApi && e.status === 404) return null;
    throw e;
  }),
]);
if (!hasil) Astro.response.status = 404;
const b = hasil?.data;
const paragraf = b ? keParagraf(b.isi) : [];
---

<Publik
  sorotan
  judul={b ? b.judul : "Berita tidak ditemukan"}
  deskripsi={b ? b.ringkasan || b.judul : undefined}
  jenis="article"
  pratinjau={b?.gambar ? `/gambar/berita/${encodeURIComponent(b.gambar)}?pola=og` : undefined}
>
  <section class="relative isolate overflow-hidden bg-biru-tua pt-[4.5rem] text-white" data-sorotan-bagian>
    {b?.gambar && <img src={gambar("berita", b.gambar, 800)} alt="" aria-hidden="true" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-25 blur-sm" data-paralaks />}
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(100deg,rgb(10_28_49/0.97)_0%,rgb(10_28_49/0.9)_50%,rgb(15_42_74/0.75)_100%)]"></div>
    <Orbit nada="terang" class="-right-[18%] top-[10%] h-[22rem] w-[75%] opacity-70" miring={10} bintang={[{ x: 20, y: 70, ukuran: 14 }]} />
    <div class="wadah relative pt-10 pb-28 md:pt-14 md:pb-36">
      <div class="masuk-bertahap mx-auto max-w-3xl" data-isi-sorotan>
        <nav aria-label="Jejak lokasi" class="text-sm text-white/70">
          <a href="/" class="hover:text-emas">Beranda</a>
          <span class="mx-1.5">/</span>
          <a href="/berita" class="hover:text-emas">Berita</a>
          {b && (<><span class="mx-1.5">/</span><a href={`/berita?kategori=${encodeURIComponent(b.kategori)}`} class="hover:text-emas">{b.kategori}</a></>)}
        </nav>
        {b && <p class="mt-5"><span class="inline-flex rounded-md bg-emas px-2.5 py-1 text-[11px] leading-none font-bold tracking-[0.08em] text-biru-tua uppercase">{b.kategori}</span></p>}
        <h1 class="mt-4 text-3xl leading-tight font-extrabold text-balance text-white md:text-5xl">{b ? b.judul : "Berita tidak ditemukan"}</h1>
        {
          b && (
            <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-white/75">
              <span>{tanggalPanjang(b.dibuat)}</span>
              {b.penulis && <span>Oleh {b.penulis}</span>}
              <span>{angka(b.dibaca)} kali dibaca</span>
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    !b ? (
      <section class="wadah py-12">
        <div class="kaca mx-auto max-w-xl px-6 py-12 text-center">
          <p class="text-[15px] text-teks">Berita yang dicari tidak ada, atau sudah tidak diterbitkan sekolah.</p>
          <a href="/berita" class={"mt-6 " + tombolGelap}>Semua berita</a>
        </div>
      </section>
    ) : (
      <article class="wadah relative z-10 -mt-20 md:-mt-28">
        <div class="mx-auto max-w-4xl overflow-hidden rounded-[20px] bg-gradient-to-br from-biru-tua to-biru shadow-[0_20px_50px_rgb(10_28_49/0.25)]" data-muncul>
          {b.gambar ? (
            <img src={gambar("berita", b.gambar, 1280)} srcset={srcsetGambar("berita", b.gambar, [800, 1280, 1920])} sizes="(min-width: 960px) 896px, 100vw" alt={b.judul} class="aspect-video w-full object-cover" decoding="async" />
          ) : (
            <div class="grid aspect-[21/9] place-items-center text-white/70" aria-hidden="true"><IkonNaskah ukuran={48} /></div>
          )}
        </div>

        <div class="kaca mx-auto mt-8 max-w-3xl p-6 md:p-10" data-muncul>
          {b.ringkasan && (
            <p class="mb-8 rounded-r-xl border-l-4 border-emas bg-biru-muda/70 px-5 py-4 text-[17px] leading-relaxed font-medium text-biru-tua">{b.ringkasan}</p>
          )}
          <div class="naskah text-[16.5px] text-teks">
            {paragraf.map((p) => <p class="whitespace-pre-line">{p}</p>)}
          </div>
          <div class="mt-10 flex flex-wrap gap-3 border-t border-garis pt-8">
            <a href="/berita" class="tombol-kilau inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-semibold text-biru-tua ring-1 ring-garis hover:ring-biru">← Semua berita</a>
            <a href="/ppdb/daftar" class={tombolEmas}>Daftar PPDB <IkonPanahKanan ukuran={15} /></a>
          </div>
        </div>

        {hasil.terkait.length > 0 && (
          <section class="mt-16" data-muncul>
            <h2 class="mb-6 text-xl">Baca juga</h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {hasil.terkait.map((t, i) => (
                <a href={`/berita/${t.slug}`} data-miring data-muncul={String(i * 0.07)} class={"kaca kartu-sorot group relative flex flex-col overflow-hidden " + kelasKartuAkhir(i, hasil.terkait.length)}>
                  <div class="h-40 overflow-hidden bg-gradient-to-br from-biru-tua to-biru">
                    {t.gambar ? (
                      <img src={gambar("berita", t.gambar, 640)} srcset={srcsetGambar("berita", t.gambar, [480, 640, 800])} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" alt={t.judul} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
                    ) : (
                      <div class="grid h-full place-items-center text-white/80" aria-hidden="true"><IkonNaskah ukuran={30} /></div>
                    )}
                  </div>
                  <div class="p-5">
                    <span class="text-xs font-semibold text-samar">{tanggalPanjang(t.dibuat)}</span>
                    <h3 class="mt-1.5 text-base leading-snug text-balance">{t.judul}</h3>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    )
  }
</Publik>
