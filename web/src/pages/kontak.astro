---
import Publik from "../tata/Publik.astro";
import KepalaHalaman from "../komponen/KepalaHalaman.astro";
import { data } from "../lib/tembolok";
import { alamatLengkap, belumTerisi, pesanTanyaPpdb, tautanWa } from "@/lib/format";
import FormulirKontak from "@/komponen/FormulirKontak";


/**
 * Formulir pertanyaan memakai komponen React yang sudah ada (pemeriksaan
 * isian dan kabar terkirim). Kirimannya menuju /api/pesan di asal yang sama,
 * yang diteruskan server Astro ke backend.
 */
const { profil } = await data.profil();
const p = profil.pengaturan;
const wa = tautanWa(p.whatsapp ?? "", pesanTanyaPpdb(p.nama_sekolah ?? ""));
const jalur = [
  { label: "Alamat", isi: alamatLengkap(p.alamat, p.kode_pos), tautan: "" },
  p.telepon && { label: "Telepon", isi: p.telepon, tautan: `tel:${p.telepon}` },
  p.email && { label: "Surel", isi: p.email, tautan: `mailto:${p.email}` },
  p.jam_layanan && !belumTerisi(p.jam_layanan) && { label: "Jam layanan", isi: p.jam_layanan, tautan: "" },
].filter(Boolean) as { label: string; isi: string; tautan: string }[];
const adaPeta = Boolean(p.peta_embed && !belumTerisi(p.peta_embed));
---

<Publik sorotan judul="Kontak" deskripsi="Alamat, nomor telepon, dan formulir pertanyaan untuk sekolah.">
  <KepalaHalaman
    pengaturan={p}
    judul="Kontak Sekolah"
    keterangan="Sampaikan pertanyaan seputar pendaftaran, biaya, atau kegiatan sekolah. Panitia akan membalas melalui jalur yang Anda cantumkan."
    induk="/kontak"
    jalur="/kontak"
  />

  <div class="wadah">
    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Hubungi</p>
      <div class="min-w-0">
        <h2 class="judul-bagian">Alamat dan jalur kontak</h2>
        <dl>
          {
            jalur.map((j) => (
              <div class="grid gap-1 border-t border-garis py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
                <dt class="text-sm text-samar">{j.label}</dt>
                <dd>
                  {j.tautan ? (
                    <a href={j.tautan} class="text-lg font-semibold break-all text-biru-tua underline-offset-4 hover:underline">{j.isi}</a>
                  ) : (
                    <p class="text-lg leading-relaxed text-teks">{j.isi}</p>
                  )}
                </dd>
              </div>
            ))
          }
          <div class="grid gap-1 border-y border-garis py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="text-sm text-samar">WhatsApp panitia PPDB</dt>
            <dd>
              {
                wa ? (
                  <a href={wa} target="_blank" rel="noopener noreferrer" class="text-lg font-semibold text-biru-tua underline underline-offset-4 hover:text-biru">Chat lewat WhatsApp</a>
                ) : (
                  <p class="text-[15px] text-samar">Nomor WhatsApp panitia belum tersedia. Gunakan telepon, surel, atau formulir di bawah.</p>
                )
              }
            </dd>
          </div>
        </dl>
        {adaPeta && <div class="peta-sematan mt-8 overflow-hidden rounded-2xl" set:html={p.peta_embed} />}
      </div>
    </section>

    <section class="bagian-polos !border-b-0" data-muncul>
      <p class="label-bagian">Formulir</p>
      <div class="min-w-0 max-w-2xl">
        <h2 class="judul-bagian">Kirim pertanyaan</h2>
        <FormulirKontak client:visible />
      </div>
    </section>
  </div>
</Publik>
