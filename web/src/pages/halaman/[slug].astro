---
import { gambar as gambarUnggahan, srcsetGambar } from "../../lib/gambar";
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import { data } from "../../lib/tembolok";
import { bagianNaskah, belumTerisi, kalimatPertama, kePoinTerisi } from "@/lib/format";
import { Menunggu, Naskah } from "@/komponen/Halaman";
import PetakGaleri from "@/komponen/Galeri";
import { IkonNaskah, IkonPanahKanan } from "@/komponen/Ikon";
import { tombolGelap } from "../../lib/gaya";
import type { Galeri, Halaman } from "@/lib/tipe";

/**
 * Halaman naskah dari tabel `halaman`: Kurikulum, OSIS, Pendidikan Karakter,
 * dan halaman lain yang dibuat panitia. Aturannya sama dengan versi Next
 * (frontend/src/app/(publik)/halaman/[slug]/page.tsx): visi dan misi milik
 * halamannya sendiri bila diisi, daftar isi bila naskahnya dipecah "## ",
 * dan dokumentasi foto bila halamannya menunjuk sebuah kategori galeri.
 */
const INDUK: Record<string, string> = { Profil: "/profil", Akademik: "/akademik", Kesiswaan: "/kesiswaan" };
const ILUSTRASI: Record<string, { berkas: string; alt: string }> = {
  osis: { berkas: "/ilustrasi/halaman/osis.jpg", alt: "Ilustrasi empat siswa berseragam putih berbincang di halaman sekolah" },
  "pendidikan-karakter": {
    berkas: "/ilustrasi/halaman/pendidikan-karakter.jpg",
    alt: "Ilustrasi empat siswa berseragam putih membawa buku di halaman sekolah",
  },
};

const slug = Astro.params.slug ?? "";
const [{ profil }, h] = await Promise.all([
  data.profil(),
  data.halamanDetail(slug).then((x) => x.data).catch((): Halaman | null => null),
]);
if (!h) Astro.response.status = 404;

const adaRingkasan = h ? !belumTerisi(h.ringkasan) : false;
const adaNaskah = h ? !belumTerisi(h.isi) : false;
const gambar = h ? ILUSTRASI[h.slug] : undefined;
const bagian = h && adaNaskah ? bagianNaskah(h.isi).bagian : [];
const adaVisiMisi = h ? h.visi.trim() !== "" || h.misi.trim() !== "" : false;
const misi = h ? kePoinTerisi(h.misi) : [];
const kategoriGaleri = h?.galeri_kategori.trim() ?? "";
const foto = kategoriGaleri
  ? await data.galeri().then((g) => g.data.filter((f) => f.kategori === kategoriGaleri)).catch((): Galeri[] => [])
  : [];
const induk = h ? INDUK[h.kelompok] : undefined;
---

<Publik sorotan judul={h ? h.judul : "Halaman tidak ditemukan"} deskripsi={h && adaRingkasan ? h.ringkasan : undefined}>
  {
    !h ? (
      <>
        <KepalaHalaman pengaturan={profil.pengaturan} judul="Halaman tidak ditemukan" induk="" jalur="" />
        <section class="wadah py-16">
          <div class="kaca mx-auto max-w-xl px-6 py-12 text-center">
            <p class="text-[15px] leading-relaxed text-teks">Halaman yang dicari tidak ada, atau sudah tidak diterbitkan sekolah.</p>
            <a href="/" class={"mt-6 " + tombolGelap}>Kembali ke beranda</a>
          </div>
        </section>
      </>
    ) : (
      <>
        <KepalaHalaman
          pengaturan={profil.pengaturan}
          judul={h.judul}
          keterangan={adaRingkasan ? h.ringkasan : undefined}
          induk={induk ?? ""}
          jalur={`/halaman/${h.slug}`}
        />

        <div class="wadah space-y-6 py-12 md:py-16">
          <section aria-labelledby="judul-pembuka-halaman" class="kaca group relative overflow-hidden" data-muncul>
            {gambar && (
              <img
                src={gambar.berkas}
                alt=""
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-[58%] object-cover object-center transition duration-700 group-hover:scale-[1.03] sm:block [mask-image:linear-gradient(to_right,transparent,#000_42%)] [-webkit-mask-image:linear-gradient(to_right,transparent,#000_42%)]"
              />
            )}
            <div class="relative p-6 sm:max-w-[48%] sm:p-8">
              <p class="inline-flex rounded-md bg-biru-tua px-2.5 py-1 text-[11px] font-bold tracking-[0.14em] text-white uppercase">
                {h.kelompok === "Profil" ? "Profil Sekolah" : h.kelompok}
              </p>
              <h2 id="judul-pembuka-halaman" class="mt-3 text-2xl leading-tight font-bold md:text-3xl">{h.judul}</h2>
              <span aria-hidden="true" class="mt-3 block h-1 w-16 rounded-full bg-emas"></span>
              {adaRingkasan && <p class="mt-4 text-[15px] leading-relaxed text-teks">{h.ringkasan}</p>}
            </div>
            {gambar && <img src={gambar.berkas} alt={gambar.alt} class="pointer-events-none block h-28 w-full object-cover object-top sm:hidden" />}
          </section>

          {bagian.length > 1 && (
            <nav aria-label={`Bagian halaman ${h.judul}`} class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {bagian.map((b, i) => (
                <a href={`#${b.id}`} data-miring data-muncul={String(i * 0.05)} class="kaca kartu-sorot group relative flex h-full items-center gap-3 p-4">
                  <span aria-hidden="true" class="ikon-kartu grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-biru-muda text-sm font-bold text-biru tabular-nums">{i + 1}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm leading-snug font-bold text-biru-tua">{b.judul}</span>
                    {kalimatPertama(b.paragraf) && <span class="mt-0.5 block text-xs leading-snug text-samar">{kalimatPertama(b.paragraf)}</span>}
                  </span>
                  <span aria-hidden="true" class="shrink-0 text-biru transition group-hover:translate-x-1"><IkonPanahKanan ukuran={16} /></span>
                </a>
              ))}
            </nav>
          )}

          {adaVisiMisi && (
            <div class="grid auto-rows-fr gap-4 lg:grid-cols-2">
              <section aria-labelledby="judul-visi-halaman" class="kaca h-full border-l-4 !border-l-emas p-5 sm:p-6" data-muncul>
                <p class="text-xs font-bold tracking-[0.18em] text-biru uppercase">Arah</p>
                <h2 id="judul-visi-halaman" class="mt-1.5 text-xl font-bold">Visi {h.judul}</h2>
                <span aria-hidden="true" class="mt-3 block h-1 w-12 rounded-full bg-emas"></span>
                {belumTerisi(h.visi) ? (
                  <div class="mt-4"><Menunggu apa={`Rumusan visi ${h.judul}`} dari="Halaman Profil" polos /></div>
                ) : (
                  <p class="mt-4 text-[15px] leading-relaxed font-semibold text-biru-tua">{h.visi}</p>
                )}
              </section>
              <section aria-labelledby="judul-misi-halaman" class="kaca h-full p-5 sm:p-6" data-muncul="0.08">
                <p class="text-xs font-bold tracking-[0.18em] text-biru uppercase">Langkah</p>
                <h2 id="judul-misi-halaman" class="mt-1.5 text-xl font-bold">Misi {h.judul}</h2>
                <span aria-hidden="true" class="mt-3 block h-1 w-12 rounded-full bg-emas"></span>
                {misi.length === 0 ? (
                  <div class="mt-4"><Menunggu apa={`Rumusan misi ${h.judul}`} dari="Halaman Profil" polos /></div>
                ) : (
                  <ol class="mt-3 divide-y divide-garis">
                    {misi.map((m, i) => (
                      <li class="flex gap-3 py-3">
                        <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-biru-tua text-xs font-bold text-white tabular-nums">{i + 1}</span>
                        <span class="text-[15px] leading-relaxed text-teks">{m}</span>
                      </li>
                    ))}
                  </ol>
                )}
              </section>
            </div>
          )}

          <article data-muncul>
            {h.gambar && (
              <img src={gambarUnggahan("profil", h.gambar, 1280)} srcset={srcsetGambar("profil", h.gambar, [800, 1280, 1920])} sizes="(min-width: 1200px) 1168px, 100vw" alt={h.judul} class="mb-6 aspect-video w-full rounded-[18px] bg-biru-muda object-cover" loading="lazy" decoding="async" />
            )}
            {adaNaskah ? (
              <div class="kaca p-6 md:p-10"><div class="max-w-3xl"><Naskah isi={h.isi} /></div></div>
            ) : (
              <div class="kaca px-6 py-12 text-center">
                <span aria-hidden="true" class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-biru-muda text-biru"><IkonNaskah ukuran={26} /></span>
                <h2 class="mt-4 text-lg font-bold">Naskah halaman {h.judul} belum tersedia</h2>
                <div class="mx-auto mt-2 max-w-xl [&_p]:not-italic">
                  <Menunggu apa={`Naskah halaman ${h.judul}`} dari="Halaman Profil" polos />
                </div>
                <a href="/kontak" class={"mt-6 " + tombolGelap}>Tanyakan ke sekolah <IkonPanahKanan ukuran={15} /></a>
              </div>
            )}
          </article>

          {kategoriGaleri && (
            <section aria-labelledby="judul-dokumentasi" class="pt-4" data-muncul>
              <p class="text-xs font-bold tracking-[0.16em] text-biru uppercase">Dokumentasi</p>
              <h2 id="judul-dokumentasi" class="mt-1 text-lg font-bold sm:text-xl">Foto Kegiatan {h.judul}</h2>
              <span aria-hidden="true" class="mt-3 block h-1 w-12 rounded-full bg-emas"></span>
              <div class="mt-5">
                {foto.length === 0 ? (
                  <p class="kaca px-5 py-6 text-center text-sm leading-relaxed text-samar">
                    Belum ada foto dokumentasi. Fotonya diunggah lewat menu Galeri di panel admin, dengan kategori
                    <span class="font-semibold text-teks"> {kategoriGaleri}</span>. Foto yang diunggah di sana juga tampil di halaman Galeri.
                  </p>
                ) : (
                  <PetakGaleri client:visible foto={foto} kategori={[]} />
                )}
              </div>
            </section>
          )}
        </div>
      </>
    )
  }
</Publik>
