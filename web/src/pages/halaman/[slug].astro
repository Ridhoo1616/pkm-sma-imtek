---
import { gambar as gambarUnggahan, srcsetGambar } from "../../lib/gambar";
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import { data } from "../../lib/tembolok";
import { bagianNaskah, belumTerisi, kePoinTerisi } from "@/lib/format";
import PetakGaleri from "@/komponen/Galeri";
import ParagrafNaskah from "@/komponen/ParagrafNaskah";
import { tombolGelap } from "../../lib/gaya";
import type { Galeri, Halaman } from "@/lib/tipe";

/**
 * Halaman naskah dari tabel `halaman`: Kurikulum, OSIS, Pendidikan Karakter,
 * dan halaman lain yang dibuat panitia. Aturannya sama dengan versi Next
 * (frontend/src/app/(publik)/halaman/[slug]/page.tsx): visi dan misi milik
 * halamannya sendiri bila diisi, daftar isi bila naskahnya dipecah "## ",
 * dan dokumentasi foto bila halamannya menunjuk sebuah kategori galeri.
 */
const INDUK: Record<string, string> = { Profil: "/profil", Akademik: "/akademik", Kesiswaan: "/kesiswaan" };

const slug = Astro.params.slug ?? "";
const [{ profil }, h] = await Promise.all([
  data.profil(),
  data.halamanDetail(slug).then((x) => x.data).catch((): Halaman | null => null),
]);
if (!h) Astro.response.status = 404;

const adaRingkasan = h ? !belumTerisi(h.ringkasan) : false;
const adaNaskah = h ? !belumTerisi(h.isi) : false;
const naskah = h && adaNaskah ? bagianNaskah(h.isi) : { pembuka: [], bagian: [] };
const { pembuka, bagian } = naskah;
const adaIsi = pembuka.length > 0 || bagian.length > 0 || Boolean(h?.gambar);
const misi = h ? kePoinTerisi(h.misi) : [];
const adaVisi = h ? !belumTerisi(h.visi) : false;
const adaVisiMisi = adaVisi || misi.length > 0;
const kategoriGaleri = h?.galeri_kategori.trim() ?? "";
const foto = kategoriGaleri
  ? await data.galeri().then((g) => g.data.filter((f) => f.kategori === kategoriGaleri)).catch((): Galeri[] => [])
  : [];
const induk = h ? INDUK[h.kelompok] : undefined;
---

<Publik sorotan judul={h ? h.judul : "Halaman tidak ditemukan"} deskripsi={h && adaRingkasan ? h.ringkasan : undefined}>
  {
    !h ? (
      <>
        <KepalaHalaman pengaturan={profil.pengaturan} judul="Halaman tidak ditemukan" induk="" jalur="" />
        <section class="wadah py-16">
          <div class="kaca mx-auto max-w-xl px-6 py-12 text-center">
            <p class="text-[15px] leading-relaxed text-teks">Halaman yang dicari tidak ada, atau sudah tidak diterbitkan sekolah.</p>
            <a href="/" class={"mt-6 " + tombolGelap}>Kembali ke beranda</a>
          </div>
        </section>
      </>
    ) : (
      <>
        <KepalaHalaman
          pengaturan={profil.pengaturan}
          judul={h.judul}
          keterangan={adaRingkasan ? h.ringkasan : undefined}
          induk={induk ?? ""}
          jalur={`/halaman/${h.slug}`}
        />

        <div class="wadah pt-12 pb-4 md:pt-16">
          {
            (pembuka.length > 0 || bagian.length > 0 || h.gambar) && (
              <div class="grid gap-8 pb-14 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16" data-muncul>
                <aside>
                  {bagian.length > 1 && (
                    <nav aria-label={`Bagian halaman ${h.judul}`} class="lg:sticky lg:top-28" data-daftar-isi>
                      <p class="label-bagian !pt-0">Di halaman ini</p>
                      {/* Garis kemajuan baca; diisi skrip di bawah, kosong tanpa skrip. */}
                      <div class="mt-3 h-1 overflow-hidden rounded-full bg-garis" aria-hidden="true">
                        <span class="block h-full origin-left scale-x-0 rounded-full bg-emas transition-transform duration-200" data-kemajuan></span>
                      </div>
                      <ol class="mt-4 space-y-1 text-[15px]">
                        {bagian.map((b, i) => (
                          <li class="group" data-isi={b.id}>
                            <a href={`#${b.id}`} class="flex items-center gap-3 rounded-lg px-2 py-1.5 leading-snug text-teks transition-colors hover:bg-biru-muda/70 hover:text-biru group-data-[aktif]:bg-biru-muda group-data-[aktif]:font-semibold group-data-[aktif]:text-biru-tua">
                              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-xs font-bold text-emas tabular-nums ring-1 ring-emas/50 transition-colors group-data-[aktif]:bg-emas group-data-[aktif]:text-biru-tua group-data-[aktif]:ring-emas" aria-hidden="true">{i + 1}</span>
                              <span>{b.judul}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </nav>
                  )}
                </aside>
                <article class="min-w-0" data-artikel>
                  {h.gambar && (
                    <img src={gambarUnggahan("profil", h.gambar, 1280)} srcset={srcsetGambar("profil", h.gambar, [800, 1280, 1920])} sizes="(min-width: 1200px) 900px, 100vw" alt={h.judul} class="mb-10 aspect-video w-full rounded-2xl bg-biru-muda object-cover" loading="lazy" decoding="async" />
                  )}
                  <div class="max-w-[68ch] space-y-5">
                    {pembuka.map((p, i) => (
                      <p class={"whitespace-pre-line text-teks " + (i === 0 && bagian.length > 0 ? "text-xl leading-relaxed" : "text-[17px] leading-relaxed")}>{p}</p>
                    ))}
                  </div>
                  {bagian.map((b) => (
                    <section class="mt-12 border-t border-garis pt-8 first:mt-0 first:border-0 first:pt-0">
                      <h2 id={b.id} class="scroll-mt-28 text-2xl leading-tight font-bold tracking-tight text-biru-tua">{b.judul}</h2>
                      <div class="mt-4 max-w-[68ch] space-y-4">
                        {b.paragraf.map((p) => <ParagrafNaskah teks={p} judul={b.judul} className="whitespace-pre-line text-[17px] leading-relaxed text-teks" />)}
                      </div>
                    </section>
                  ))}
                </article>
              </div>
            )
          }

          {
            !adaIsi && !adaVisiMisi && (
              <section class="bagian-polos">
                <p class="label-bagian">Naskah</p>
                <div>
                  <h2 class="judul-bagian">Belum diterbitkan</h2>
                  <p class="max-w-xl text-[17px] leading-relaxed text-samar">
                    Sekolah belum mengirim naskah untuk halaman ini.
                  </p>
                </div>
              </section>
            )
          }

          {
            adaVisiMisi && (
              <>
                {adaVisi && (
                  <section class="bagian-polos" aria-labelledby="judul-visi-halaman" data-muncul>
                    <p class="label-bagian">Arah</p>
                    <div>
                      <h2 id="judul-visi-halaman" class="judul-bagian">Visi {h.judul}</h2>
                      <p class="max-w-[40ch] text-2xl leading-snug font-semibold text-biru-tua">{h.visi}</p>
                    </div>
                  </section>
                )}
                {misi.length > 0 && (
                  <section class="bagian-polos" aria-labelledby="judul-misi-halaman" data-muncul>
                    <p class="label-bagian">Langkah</p>
                    <div>
                      <h2 id="judul-misi-halaman" class="judul-bagian">Misi {h.judul}</h2>
                      <ol>
                        {misi.map((m, i) => (
                          <li class="grid grid-cols-[3rem_1fr] gap-3 border-t border-garis py-4 last:border-b">
                            <span class="text-3xl leading-none font-semibold text-emas tabular-nums">{i + 1}</span>
                            <span class="pt-1 text-lg leading-snug text-teks">{m}</span>
                          </li>
                        ))}
                      </ol>
                    </div>
                  </section>
                )}
              </>
            )
          }

          {
            kategoriGaleri && (
              <section class="bagian-polos !border-b-0" aria-labelledby="judul-dokumentasi" data-muncul>
                <p class="label-bagian">Dokumentasi</p>
                <div class="min-w-0">
                  <h2 id="judul-dokumentasi" class="judul-bagian">Foto kegiatan {h.judul}</h2>
                  {foto.length === 0 ? (
                    <p class="max-w-xl text-[15px] leading-relaxed text-samar">
                      Foto kegiatan {h.judul} akan ditampilkan di sini. Sementara itu, dokumentasi kegiatan sekolah lainnya dapat dilihat di
                      halaman <a href="/galeri" class="font-semibold text-biru underline-offset-4 hover:underline">Galeri</a>.
                    </p>
                  ) : (
                    <PetakGaleri client:visible foto={foto} kategori={[]} />
                  )}
                </div>
              </section>
            )
          }
        </div>
      </>
    )
  }
<script>
  // Daftar isi menandai bagian yang sedang dibaca dan mengisi garis kemajuan
  // baca. Tanpa skrip, daftar isinya tetap berupa tautan biasa.
  const nav = document.querySelector<HTMLElement>("[data-daftar-isi]");
  const artikel = document.querySelector<HTMLElement>("[data-artikel]");
  if (nav && artikel) {
    const butir = [...nav.querySelectorAll<HTMLElement>("[data-isi]")];
    const judul = butir.map((li) => document.getElementById(li.dataset.isi ?? ""));
    const batang = nav.querySelector<HTMLElement>("[data-kemajuan]");
    let menunggu = false;
    // Butir yang baru diklik dipertahankan selama guliran menuju judulnya,
    // supaya tandanya tidak melompat-lompat melewati bagian di antaranya.
    let dipilih = -1;
    let lepas = 0;
    const tandai = (aktif: number) => butir.forEach((li, i) => li.toggleAttribute("data-aktif", i === aktif));
    const segarkan = () => {
      menunggu = false;
      // Patokannya tempat judul berhenti sesudah diklik (scroll-mt-28 = 112
      // piksel) ditambah sedikit kelonggaran. Patokan sepertiga layar keliru
      // pada naskah yang bagiannya pendek: judul berikutnya ikut terlewati.
      const garis = 150;
      let aktif = 0;
      judul.forEach((h, i) => {
        if (h && h.getBoundingClientRect().top <= garis) aktif = i;
      });
      // Bagian terakhir yang pendek tidak pernah mencapai garis; di dasar
      // halaman, dialah yang sedang dibaca.
      const dasar = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      if (dasar && dipilih < 0) aktif = butir.length - 1;
      tandai(dipilih >= 0 ? dipilih : aktif);
      const r = artikel.getBoundingClientRect();
      const kemajuan = dasar ? 1 : Math.min(1, Math.max(0, (garis - r.top) / Math.max(1, r.height - garis)));
      if (batang) batang.style.transform = `scaleX(${kemajuan})`;
    };
    butir.forEach((li, i) =>
      li.querySelector("a")?.addEventListener("click", () => {
        dipilih = i;
        tandai(i);
        clearTimeout(lepas);
        lepas = window.setTimeout(() => {
          dipilih = -1;
        }, 1200);
      }),
    );
    addEventListener("scroll", () => {
      if (!menunggu) requestAnimationFrame(segarkan);
      menunggu = true;
    }, { passive: true });
    segarkan();
  }
</script>
</Publik>
