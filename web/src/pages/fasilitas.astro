---
import { gambar, srcsetGambar } from "../lib/gambar";
import Publik from "../tata/Publik.astro";
import KepalaHalaman from "../komponen/KepalaHalaman.astro";
import { data } from "../lib/tembolok";
import { IkonFasilitas } from "@/komponen/Ikon";
import { kelasKartuAkhir } from "@/komponen/Bagian";
import type { Fasilitas } from "@/lib/tipe";

/**
 * Butir "Sarana dan Prasarana" pada menu Profil Sekolah. Alamatnya tetap
 * /fasilitas karena halaman ini sudah ada lebih dulu; jejak dan bilah
 * halaman sekelompoknya mencocokkan isi daftar menu, bukan awalan jalurnya.
 */
const [{ profil }, fasilitas] = await Promise.all([
  data.profil(),
  data.fasilitas().then((h) => h.data).catch((): Fasilitas[] => []),
]);
const p = profil.pengaturan;
---

<Publik sorotan judul="Fasilitas Sekolah" deskripsi="Sarana dan prasarana yang menunjang kegiatan belajar.">
  <KepalaHalaman
    pengaturan={p}
    judul="Sarana dan Prasarana"
    keterangan="Sarana yang tersedia untuk menunjang kegiatan belajar, praktik, ibadah, dan olahraga sehari-hari."
    induk="/profil"
    jalur="/fasilitas"
  />

  <section class="wadah py-12 md:py-16">
    {
      fasilitas.length === 0 ? (
        <div class="kaca px-6 py-14 text-center">
          <p class="text-lg font-semibold text-biru-tua">Data fasilitas belum tersedia</p>
          <p class="mt-2 text-sm text-samar">Daftar fasilitas dapat ditambahkan lewat menu Fasilitas di panel admin.</p>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {fasilitas.map((f, i) => (
            <article data-miring data-muncul={String((i % 3) * 0.07)} class={"kaca kartu-sorot group relative flex flex-col overflow-hidden " + kelasKartuAkhir(i, fasilitas.length)}>
              <div class="relative h-48 overflow-hidden bg-gradient-to-br from-biru-tua to-biru">
                {f.gambar ? (
                  <img
                    src={gambar("fasilitas", f.gambar, 640)} srcset={srcsetGambar("fasilitas", f.gambar, [480, 640, 800])} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                    alt={f.nama}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  /* Tanpa foto: ikon besar di atas latar sekolah, bukan kotak
                     kelabu bertuliskan nama yang sama dengan judul di bawahnya. */
                  <div class="grid h-full place-items-center text-white/85" aria-hidden="true">
                    <span class="ikon-kartu grid h-20 w-20 place-items-center rounded-2xl bg-white/10 ring-1 ring-white/15">
                      <IkonFasilitas nama={f.ikon} ukuran={40} />
                    </span>
                  </div>
                )}
                <span class="absolute top-3 left-3 rounded-md bg-white px-2 py-1 text-[10px] leading-none font-bold tracking-[0.08em] text-biru-tua tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <div class="flex-1 p-5">
                <h2 class="flex items-center gap-2.5 text-base">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-biru-muda text-biru" aria-hidden="true">
                    <IkonFasilitas nama={f.ikon} ukuran={17} />
                  </span>
                  {f.nama}
                </h2>
                {f.deskripsi && <p class="mt-2.5 text-sm leading-relaxed text-samar">{f.deskripsi}</p>}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Publik>
