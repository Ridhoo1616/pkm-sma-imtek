---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import PetaAnak from "../../komponen/PetaAnak.astro";
import KartuLowongan from "../../komponen/KartuLowongan.astro";
import { data } from "../../lib/tembolok";
import { belumTerisi, namaLengkapSekolah, tautanWa } from "@/lib/format";
import { Naskah } from "@/komponen/Halaman";
import { tombolEmas, tombolPutih } from "../../lib/gaya";
import type { LowonganBkk } from "@/lib/tipe";

/**
 * Halaman Bursa Kerja Khusus. Angka yang tampil dihitung backend dari data
 * lowongan dan lamaran, dan disembunyikan selama nilainya nol: halaman
 * promosi tidak memamerkan angka yang belum ada.
 */
type HasilLowongan = { data: LowonganBkk[]; angka: { mitra: number; lowongan_dibuka: number; tersalurkan: number } };
const [{ profil }, hasil] = await Promise.all([
  data.profil(),
  data.lowonganBkk().catch((): HasilLowongan => ({ data: [], angka: { mitra: 0, lowongan_dibuka: 0, tersalurkan: 0 } })),
]);
const p = profil.pengaturan;
const pengantar = p.bkk_keterangan ?? "";
const nama = namaLengkapSekolah(p);
const wa = tautanWa(p.bkk_kontak || p.whatsapp || "", `Halo petugas BKK ${nama}, saya lulusan ${nama} ingin bertanya tentang lowongan kerja.`);
const angka = [
  { nilai: hasil.angka.lowongan_dibuka, label: "Lowongan dibuka" },
  { nilai: hasil.angka.mitra, label: "Perusahaan mitra" },
  { nilai: hasil.angka.tersalurkan, label: "Lulusan tersalurkan" },
].filter((a) => a.nilai > 0);
const terbaru = hasil.data.slice(0, 6);
// Ditulis utuh supaya terpindai Tailwind; jumlah kolom mengikuti angka yang ada.
const KOLOM_ANGKA: Record<number, string> = { 1: "", 2: "sm:grid-cols-2", 3: "sm:grid-cols-3" };
const alur = [
  { judul: "Pilih lowongan", isi: "Lowongan dari perusahaan mitra yang sedang dibuka, lengkap dengan kualifikasi dan batas lamarannya." },
  { judul: "Kirim lamaran", isi: "Isi data diri, NISN, dan unggah CV langsung di halaman lowongan. Tidak perlu datang ke sekolah." },
  { judul: "Diteruskan ke mitra", isi: "Petugas BKK memeriksa lamaran lalu meneruskannya ke perusahaan, termasuk jadwal wawancara." },
  { judul: "Pantau hasilnya", isi: "Tahap lamaran dan catatan petugas dapat dilihat kapan saja dengan NISN dan tanggal lahir." },
];
---

<Publik sorotan judul="Bursa Kerja Khusus" deskripsi={`Bursa Kerja Khusus ${nama}: lowongan kerja dari perusahaan mitra dan penyaluran lulusan ke dunia kerja.`}>
  <KepalaHalaman
    pengaturan={p}
    judul="Bursa Kerja Khusus"
    keterangan="Layanan sekolah yang mempertemukan lulusan dengan perusahaan mitra: dari informasi lowongan, pengiriman lamaran, sampai penyaluran kerja."
    induk="/bkk"
    jalur="/bkk"
  />

  <div class="wadah pt-10 pb-4">
    {
      angka.length > 0 && (
        <dl class={"grid border-b border-garis " + KOLOM_ANGKA[angka.length]} data-muncul>
          {angka.map((a, i) => (
            <div class={"flex flex-col-reverse py-7 " + (i > 0 ? "border-t border-garis sm:border-t-0 sm:border-l sm:pl-7" : "")}>
              <dt class="mt-2 text-sm text-samar">{a.label}</dt>
              <dd class="text-5xl leading-none font-semibold tracking-tight text-biru-tua tabular-nums" data-hitung={a.nilai}>{a.nilai}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      !belumTerisi(pengantar) && (
        <section class="bagian-polos" data-muncul>
          <p class="label-bagian">Tentang</p>
          <div class="max-w-[68ch]"><Naskah isi={pengantar} /></div>
        </section>
      )
    }

    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Alur penyaluran</p>
      <div>
        <h2 class="judul-bagian">Dari lowongan sampai diterima bekerja</h2>
        <ol>
          {
            alur.map((a, i) => (
              <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-t border-garis py-5 last:border-b">
                <span class="text-4xl leading-none font-semibold text-emas tabular-nums" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="text-lg font-semibold text-biru-tua">{a.judul}</h3>
                  <p class="mt-1 max-w-[60ch] text-[15px] leading-relaxed text-samar">{a.isi}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Lowongan terbaru</p>
      <div class="min-w-0">
        <h2 class="judul-bagian">{terbaru.length ? "Sedang dibuka" : "Belum ada lowongan yang dibuka"}</h2>
        {
          terbaru.length === 0 ? (
            <p class="max-w-xl text-[15px] leading-relaxed text-samar">Lowongan baru diumumkan di halaman ini begitu perusahaan mitra membukanya.</p>
          ) : (
            <>
              <div class="grid gap-5 sm:grid-cols-2">
                {terbaru.map((l, i) => <KartuLowongan l={l} i={i} jumlah={terbaru.length} />)}
              </div>
              {hasil.data.length > terbaru.length && (
                <p class="mt-8">
                  <a href="/bkk/lowongan" class={tombolPutih}>Lihat semua {hasil.data.length} lowongan</a>
                </p>
              )}
            </>
          )
        }
      </div>
    </section>

    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Di BKK</p>
      <div>
        <h2 class="judul-bagian">Halaman lainnya</h2>
        <PetaAnak induk="/bkk" />
      </div>
    </section>

    {
      wa && (
        <section class="bagian-polos !border-b-0" data-muncul>
          <p class="label-bagian">Bantuan</p>
          <div>
            <h2 class="judul-bagian">Ada pertanyaan tentang lowongan?</h2>
            <p class="max-w-xl text-[15px] leading-relaxed text-samar">Petugas BKK membantu lulusan menyiapkan lamaran dan menjawab pertanyaan seputar penyaluran kerja.</p>
            <a href={wa} target="_blank" rel="noopener noreferrer" class={tombolEmas + " mt-5"}>Hubungi petugas BKK</a>
          </div>
        </section>
      )
    }
  </div>
</Publik>
