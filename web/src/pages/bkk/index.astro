---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import { gambar } from "../../lib/gambar";
import { data } from "../../lib/tembolok";
import { belumTerisi, namaLengkapSekolah, tautanWa } from "@/lib/format";
import { Naskah } from "@/komponen/Halaman";
import { IkonWhatsapp } from "@/komponen/Ikon";
import { tombolEmas, tombolPutih } from "../../lib/gaya";
import type { MitraBkk } from "@/lib/tipe";

/**
 * Halaman Bursa Kerja Khusus. Penyaluran kerja sekolah berjalan lewat grup
 * WhatsApp yang dipegang petugas BKK, jadi halaman ini cukup profil singkat,
 * daftar perusahaan mitra, dan jalan masuk ke grup itu (migrasi 033). Alumni
 * dan lowongan punya halaman sendiri di sub menu BKK.
 */
const [{ profil }, hasilMitra] = await Promise.all([
  data.profil(),
  data.mitraBkk().catch(() => ({ data: [] as MitraBkk[] })),
]);
const p = profil.pengaturan;
const nama = namaLengkapSekolah(p);
const profilSingkat = p.bkk_keterangan ?? "";
const nomorDisnaker = (p.bkk_nomor_disnaker ?? "").trim();
const nomorAdmin = (p.bkk_kontak || p.whatsapp || "").trim();
const chatAdmin = tautanWa(nomorAdmin, `Halo admin BKK ${nama}, saya ingin bergabung dengan grup WhatsApp BKK untuk info penyaluran kerja.`);
// Tautan undangan grup lebih dulu; tanpa itu, tombol gabung membuka chat admin.
const grup = /^https?:\/\//.test((p.bkk_grup_wa ?? "").trim()) ? p.bkk_grup_wa!.trim() : "";
const gabung = grup || chatAdmin;
const mitra = hasilMitra.data;

const fakta = [
  nomorDisnaker && { label: "Tanda daftar Disnaker", isi: nomorDisnaker },
  { label: "Semboyan", isi: "Belajar · Berkarya · Bermanfaat" },
  !belumTerisi(p.alamat ?? "") && { label: "Sekretariat", isi: p.alamat! },
].filter(Boolean) as { label: string; isi: string }[];
---

<Publik sorotan judul="Bursa Kerja Khusus" deskripsi={`Bursa Kerja Khusus ${nama}: program penyaluran lulusan ke dunia kerja bersama perusahaan mitra.`}>
  <KepalaHalaman
    pengaturan={p}
    judul="Bursa Kerja Khusus"
    keterangan="Program sekolah untuk menyalurkan lulusan ke dunia kerja bersama perusahaan mitra."
    induk="/bkk"
    lambang={{ src: "/bkk/logo-bkk.svg", alt: "Logo BKK SMAS IMTEK" }}
    jalur="/bkk"
  />

  <div class="wadah pt-10 pb-4">
    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Profil</p>
      <div>
        <h2 class="judul-bagian">Program penyaluran kerja</h2>
        {
          belumTerisi(profilSingkat) ? (
            <p class="max-w-xl text-[15px] leading-relaxed text-samar">Profil singkat BKK sedang disiapkan sekolah.</p>
          ) : (
            <div class="max-w-[68ch]"><Naskah isi={profilSingkat} /></div>
          )
        }
        <dl class="mt-8 grid border-t border-garis sm:grid-cols-3">
          {
            fakta.map((f, i) => (
              <div class={"py-5 " + (i > 0 ? "border-t border-garis sm:border-t-0 sm:border-l sm:pl-6" : "sm:pr-6")}>
                <dt class="text-xs font-semibold tracking-wide text-samar uppercase">{f.label}</dt>
                <dd class="mt-1.5 text-[15px] font-semibold text-biru-tua">{f.isi}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="bagian-polos" data-muncul>
      <p class="label-bagian">Mitra</p>
      <div class="min-w-0">
        <h2 class="judul-bagian">Perusahaan yang bekerja sama</h2>
        {
          mitra.length === 0 ? (
            <p class="max-w-xl text-[15px] leading-relaxed text-samar">Daftar mitra ditambahkan petugas BKK lewat panel admin.</p>
          ) : (
            <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {mitra.map((m) => (
                <li class="flex flex-col gap-3 rounded-2xl bg-white p-4 ring-1 ring-garis">
                  {/* Logo mitra umumnya memanjang, jadi diberi selebar kartu; tanpa logo, huruf awal. */}
                  {m.logo ? (
                    <img src={gambar("bkk-mitra", m.logo, 480)} alt={`Logo ${m.nama}`} class="h-20 w-full max-w-[13rem] object-contain object-left" loading="lazy" />
                  ) : (
                    <span class="grid h-12 w-12 place-items-center rounded-lg bg-biru-muda text-base font-bold text-biru-tua" aria-hidden="true">
                      {m.nama.replace(/^(PT|CV|UPTD)\.?\s+/i, "").charAt(0)}
                    </span>
                  )}
                  <div class="min-w-0">
                    <p class="font-semibold leading-snug text-biru-tua">{m.nama}</p>
                    {m.bidang && <p class="text-sm text-samar">{m.bidang}</p>}
                    {m.alamat && <p class="mt-1.5 text-sm leading-snug text-samar">{m.alamat}</p>}
                    {/^https?:\/\//.test(m.situs) && (
                      <a href={m.situs} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-biru-tua underline underline-offset-4 hover:text-biru">Situs perusahaan</a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )
        }
        <p class="mt-6 text-[15px] text-samar">
          Info selengkapnya bisa join grup WhatsApp BKK.{" "}
          {gabung && <a href={gabung} target="_blank" rel="noopener noreferrer" class="font-semibold text-biru-tua underline underline-offset-4 hover:text-biru">Gabung sekarang</a>}
        </p>
      </div>
    </section>

    <section class="bagian-polos !border-b-0" data-muncul>
      <p class="label-bagian">Grup WhatsApp</p>
      <div>
        <h2 class="judul-bagian">Lowongan dan penyaluran lewat grup WA</h2>
        <p class="max-w-xl text-[15px] leading-relaxed text-samar">
          Info lowongan, jadwal seleksi, dan penyaluran kerja dibagikan di grup WhatsApp BKK yang dipegang admin sekolah.{" "}
          {grup ? "Lulusan bisa langsung bergabung lewat tombol di bawah." : "Hubungi admin BKK untuk dimasukkan ke grup."}
        </p>
        {
          gabung ? (
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <a href={gabung} target="_blank" rel="noopener noreferrer" class={tombolEmas}>
                <IkonWhatsapp ukuran={18} /> {grup ? "Gabung grup WhatsApp" : "Chat admin BKK"}
              </a>
              {grup && chatAdmin && (
                <a href={chatAdmin} target="_blank" rel="noopener noreferrer" class={tombolPutih}>Chat admin BKK</a>
              )}
              {nomorAdmin && <span class="text-sm text-samar">Admin BKK: <strong class="text-teks tabular-nums">{nomorAdmin}</strong></span>}
            </div>
          ) : (
            <p class="mt-4 text-[15px] text-samar">Nomor admin BKK belum diisi. Sementara, hubungi sekolah di <a href="/kontak" class="font-semibold text-biru-tua underline underline-offset-4">halaman Kontak</a>.</p>
          )
        }
      </div>
    </section>
  </div>
</Publik>
