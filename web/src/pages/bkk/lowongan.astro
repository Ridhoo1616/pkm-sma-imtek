---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import KartuLowongan from "../../komponen/KartuLowongan.astro";
import { data } from "../../lib/tembolok";
import { kontakBkk } from "../../lib/bkk";
import { namaLengkapSekolah } from "@/lib/format";
import { IkonWhatsapp } from "@/komponen/Ikon";
import { tombolEmas } from "../../lib/gaya";
import type { LowonganBkk } from "@/lib/tipe";

/**
 * Lowongan yang sedang dibuka, dikelompokkan menurut jenisnya. Lowongan
 * diisi petugas BKK di panel; melamarnya lewat admin BKK atau grup
 * WhatsApp (migrasi 033), bukan formulir di situs.
 */
const [{ profil }, hasil] = await Promise.all([
  data.profil(),
  data.lowonganBkk().catch(() => ({ data: [] as LowonganBkk[] })),
]);
const p = profil.pengaturan;
const { gabung, grup } = kontakBkk(p, namaLengkapSekolah(p));
const URUTAN = ["Penuh Waktu", "Kontrak", "Paruh Waktu", "Magang"];
const kelompok = URUTAN.map((j) => ({ jenis: j, isi: hasil.data.filter((l) => l.jenis === j) })).filter((g) => g.isi.length);
---

<Publik sorotan judul="Lowongan Dibuka" deskripsi="Lowongan kerja dari perusahaan mitra Bursa Kerja Khusus yang sedang dibuka bagi lulusan.">
  <KepalaHalaman
    pengaturan={p}
    judul="Lowongan Dibuka"
    keterangan="Lowongan dari perusahaan mitra yang sedang dibuka. Untuk melamar, hubungi admin BKK atau gabung grup WhatsApp BKK."
    induk="/bkk"
    lambang={{ src: "/bkk/logo-bkk.svg", alt: "Logo BKK SMAS IMTEK" }}
    jalur="/bkk/lowongan"
  />
  <div class="wadah">
    {
      kelompok.length === 0 ? (
        <section class="bagian-polos !border-b-0" data-muncul>
          <p class="label-bagian">Lowongan</p>
          <div>
            <h2 class="judul-bagian">Belum ada lowongan yang dibuka</h2>
            <p class="max-w-xl text-[15px] leading-relaxed text-samar">
              Lowongan baru ditampilkan di sini begitu dibuka petugas BKK. Info yang paling cepat selalu dibagikan di grup WhatsApp BKK.
            </p>
            {gabung && (
              <a href={gabung} target="_blank" rel="noopener noreferrer" class={"mt-5 " + tombolEmas}>
                <IkonWhatsapp ukuran={18} /> {grup ? "Gabung grup WhatsApp" : "Chat admin BKK"}
              </a>
            )}
          </div>
        </section>
      ) : (
        kelompok.map((g, n) => (
          <section class={"bagian-polos" + (n === kelompok.length - 1 ? " !border-b-0" : "")} data-muncul>
            <p class="label-bagian">{g.isi.length} lowongan</p>
            <div class="min-w-0">
              <h2 class="judul-bagian">{g.jenis}</h2>
              <div class="grid gap-5 sm:grid-cols-2">
                {g.isi.map((l, i) => <KartuLowongan l={l} i={i} jumlah={g.isi.length} />)}
              </div>
            </div>
          </section>
        ))
      )
    }
  </div>
</Publik>
