---
import Publik from "../../tata/Publik.astro";
import KepalaHalaman from "../../komponen/KepalaHalaman.astro";
import { gambar } from "../../lib/gambar";
import { data } from "../../lib/tembolok";
import { IkonFasilitas, IkonPanahKanan } from "@/komponen/Ikon";
import type { MitraBkk } from "@/lib/tipe";

/** Perusahaan mitra yang aktif. Kontak narahubung tidak pernah dikirim ke sini. */
const [{ profil }, hasil] = await Promise.all([
  data.profil(),
  data.mitraBkk().catch(() => ({ data: [] as MitraBkk[] })),
]);
const mitra = hasil.data;
---

<Publik sorotan judul="Mitra Industri" deskripsi="Perusahaan dan instansi yang bekerja sama dengan Bursa Kerja Khusus sekolah dalam penyaluran lulusan.">
  <KepalaHalaman
    pengaturan={profil.pengaturan}
    judul="Mitra Industri"
    keterangan="Perusahaan dan instansi yang bekerja sama dengan sekolah dalam menyalurkan lulusan ke dunia kerja."
    induk="/bkk"
    jalur="/bkk/mitra"
  />
  <div class="wadah pb-12">
    {
      mitra.length === 0 ? (
        <section class="bagian-polos !border-b-0" data-muncul>
          <p class="label-bagian">Mitra</p>
          <div>
            <h2 class="judul-bagian">Daftar mitra belum diisi</h2>
            <p class="max-w-xl text-[15px] text-samar">Mitra ditambahkan petugas BKK lewat panel admin.</p>
          </div>
        </section>
      ) : (
        <ul class="pt-10" data-muncul>
          {mitra.map((m) => (
            <li class="grid gap-4 border-t border-garis py-6 last:border-b sm:grid-cols-[4.5rem_1fr_auto] sm:items-center sm:gap-6">
              <span class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-xl bg-white ring-1 ring-garis" aria-hidden="true">
                {m.logo ? <img src={gambar("bkk-mitra", m.logo, 160)} alt="" class="h-full w-full object-contain p-1.5" /> : <IkonFasilitas ukuran={24} />}
              </span>
              <div class="min-w-0">
                <h2 class="text-xl font-semibold text-biru-tua">{m.nama}</h2>
                {m.bidang && <p class="text-[15px] text-samar">{m.bidang}</p>}
                {m.alamat && <p class="mt-1 text-sm text-samar">{m.alamat}</p>}
              </div>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm sm:flex-col sm:items-end">
                {m.lowongan_dibuka > 0 ? (
                  <a href="/bkk/lowongan" class="inline-flex items-center gap-1.5 font-semibold text-biru-tua underline underline-offset-4 hover:text-biru">
                    {m.lowongan_dibuka} lowongan dibuka <IkonPanahKanan ukuran={14} />
                  </a>
                ) : (
                  <span class="text-samar">Belum ada lowongan dibuka</span>
                )}
                {m.situs && (
                  <a href={m.situs} target="_blank" rel="noopener noreferrer" class="text-biru hover:underline">Situs perusahaan</a>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Publik>
