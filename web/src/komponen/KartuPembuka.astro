---
/**
 * Kartu pembuka berilustrasi: naskah di kiri, gambar di kanan setinggi
 * kartu, menempel tepi lewat margin negatif. Di layar sempit gambarnya turun
 * ke bawah naskah dan melebar penuh.
 *
 * Margin gambar ditulis per sisi di kedua ambang, bukan ringkasan yang
 * dibatalkan sebagian — cara itu pernah membuat gambar menggantung 29 piksel
 * di atas dasar kartu. `max-w-none` wajib bersama lebar calc(), sebab
 * preflight Tailwind memangkas setiap gambar menjadi max-width 100%.
 */
interface Props {
  atas: string;
  judul: string;
  keterangan: string;
  gambar: string;
  alt: string;
  lebar: number;
  tinggi: number;
}
const { atas, judul, keterangan, gambar, alt, lebar, tinggi } = Astro.props;
const id = `pembuka-${judul.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<section aria-labelledby={id} class="kaca group flex flex-col gap-5 overflow-hidden p-6 sm:flex-row sm:items-stretch sm:gap-6 sm:p-7" data-muncul>
  <div class="min-w-0 flex-1 sm:self-center">
    <p class="text-xs font-bold tracking-[0.18em] text-biru uppercase">{atas}</p>
    <h2 id={id} class="mt-2 text-2xl leading-tight font-bold md:text-3xl">{judul}</h2>
    <span aria-hidden="true" class="mt-3 block h-1 w-16 rounded-full bg-emas"></span>
    <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-teks">{keterangan}</p>
    <slot />
  </div>
  <img
    src={gambar}
    alt={alt}
    width={lebar}
    height={tinggi}
    class="pointer-events-none -mr-6 -mb-6 -ml-6 w-[calc(100%+3rem)] max-w-none self-end object-contain object-bottom transition duration-700 group-hover:scale-[1.03] sm:-mt-7 sm:-mr-7 sm:-mb-7 sm:ml-0 sm:w-72 sm:self-stretch md:w-96"
  />
</section>
