# Alamat backend Go, dibaca di sisi server.
NEXT_PUBLIC_API_URL=http://localhost:8090
# Frontend Next yang masih melayani halaman yang belum dipindah ke Astro.
SITUS_LAMA=http://localhost:3000
# "ya" bila Astro berjalan pada asal yang diizinkan CORS_ORIGINS backend
# (di komputer sekolah: porta 3000). Panel admin lalu DITERUSKAN tanpa
# berganti alamat. Kosongkan saat pengembangan di porta lain (misalnya 4321):
# panel admin kemudian DIALIHKAN ke alamat Next sendiri.
SITUS_LAMA_DITERUSKAN=
# Alamat publik situs begitu sekolah punya domain, misalnya
# https://smaimtek.sch.id. Dipakai sitemap, gambar pratinjau, dan alamat
# kanonis; selama kosong, alamat kanonis tidak dipasang.
ALAMAT_SITUS=
