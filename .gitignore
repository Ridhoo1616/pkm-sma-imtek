# ============================================================
#  Berkas yang TIDAK boleh masuk repositori
# ============================================================

# Dokumen pribadi pendaftar (KK, akta, ijazah, foto) dan gambar unggahan.
# Struktur foldernya tetap ikut lewat .gitkeep dan .htaccess.
legacy-php/uploads/*/*
!legacy-php/uploads/*/.gitkeep
!legacy-php/uploads/.htaccess

# Folder unggahan backend Go (isinya sama-sama data pribadi)
backend/data/

# Cadangan basis data dan arsip unggahan — berisi data pribadi calon peserta
# didik (NIK, Kartu Keluarga, akta). Pola .dump dan cadangan-*.sql ada di sini
# karena memindahkan data ke komputer lain memakai keduanya, dan berkasnya
# sering telanjur diletakkan di dalam folder repositori.
*.sql.gz
*.sql.zip
*.dump
cadangan-*.sql
unggahan*.tgz
unggahan*.tar.gz
backup/
dump/
!backend/migrations/*.sql

# Berkas sementara sistem operasi
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Berkas editor. Setelan bersama untuk proyek ini diikutkan supaya rekan
# satu tim mendapat tugas, setelan, dan saran ekstensi yang sama; berkas
# .vscode lain yang bersifat pribadi tetap dikecualikan.
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-*
*.swp
*~

# Log dan cache
*.log
error_log
.cache/

# Berkas konfigurasi lokal — memuat kredensial sungguhan
legacy-php/config/database.local.php
.env
.env.local
backend/.env

# Hasil kompilasi backend Go
/backend/backend
/backend/server
/backend/server-codespace
*.test

# Frontend Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
frontend/next-env.d.ts

# Pembuka aplikasi khusus komputer sendiri, menunjuk ke path lokal
jalankan.command
