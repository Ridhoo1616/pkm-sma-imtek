# ============================================================
#  Contoh konfigurasi backend Go
#  Salin menjadi .env lalu sesuaikan. Berkas .env TIDAK ikut ke
#  repositori karena repositori ini publik.
# ============================================================

# --- Basis data PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sma_imtek
DB_USER=postgres
DB_PASS=

# PostgreSQL menolak sambungan tanpa TLS bila disetel "require".
# Saat pengembangan di komputer sendiri, "disable" sudah memadai.
# Saat produksi pada hosting yang basis datanya terpisah, pakai "require".
DB_SSLMODE=disable

# Sebagian layanan hosting memberi satu variabel berisi seluruh
# kredensial. Bila diisi, nilai DB_* di atas diabaikan.
# DATABASE_URL=postgres://pengguna:sandi@host:5432/nama_basis_data?sslmode=require

# --- Keamanan ---
# Kunci penanda tangan token masuk. WAJIB diisi saat APP_ENV=produksi.
# Buat nilai acak, misalnya dengan: openssl rand -base64 48
JWT_SECRET=

# pengembangan | produksi
# Saat "produksi", pesan galat rinci tidak dikirim ke pengguna.
APP_ENV=pengembangan

# --- Jaringan ---
PORT=8090

# Alamat asal frontend yang boleh memanggil API ini, dipisah koma.
# Saat pengembangan, Next.js berjalan di http://localhost:3000. Peramban
# menganggap localhost dan 127.0.0.1 sebagai asal berbeda, jadi keduanya
# disebutkan. Saat produksi, ganti dengan alamat situs sekolah.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Notifikasi WhatsApp ---
# Dibiarkan kosong berarti panitia mengirim sendiri: sistem menyusun pesannya,
# panitia menekan satu tombol, dan WhatsApp terbuka dengan pesan yang sudah
# terisi. Cara itu tidak berbiaya dan tidak berisiko nomor sekolah diblokir.
#
# Diisi berarti pengiriman otomatis. Alamatnya wajib https, kecuali bila
# menunjuk ke localhost, karena gateway sering dijalankan di server yang sama.
# JANGAN memakai gateway tidak resmi yang menumpang WhatsApp Web milik nomor
# sekolah: itu melanggar ketentuan layanan dan nomornya berisiko diblokir,
# justru pada masa PPDB ketika nomor itu paling dibutuhkan.
# WA_GATEWAY_URL=https://gateway-resmi.example/kirim
# WA_GATEWAY_TOKEN=

# Nama medan pada badan permintaan gateway; tiap penyedia berbeda.
# WA_MEDAN_TUJUAN=to
# WA_MEDAN_PESAN=message

# --- Unggahan ---
# Folder penyimpanan berkas. Isinya dokumen pribadi pendaftar,
# jadi jangan diletakkan di dalam folder yang dilayani web server.
UPLOAD_DIR=data/unggahan

# Batas ukuran satu berkas dalam bita (2097152 = 2 MB)
UPLOAD_MAX_BYTES=2097152

# ---------- Pengiriman email notifikasi ----------
# Kosong berarti kanal email tidak aktif: notifikasinya tetap tersusun dan
# tercatat, tetapi belum dapat dikirim, dan panel menerangkan hal itu.
#
# Untuk Gmail: SMTP_PASS adalah SANDI APLIKASI (App Password) 16 huruf yang
# dibuat di myaccount.google.com/apppasswords, BUKAN sandi akunnya. Sandi akun
# tidak akan diterima. Gmail membatasi sekitar 500 email per hari.
#
# JANGAN pernah menaruh nilai sungguhan di berkas ini — .env.example ikut ke
# repositori, dan repositori ini publik. Isinya di berkas .env yang tidak
# ikut ke repositori.
# Jaringan yang X-Forwarded-For dari sana boleh dipercaya, dipisah koma.
# KOSONGKAN bila proksi baliknya (Caddy atau nginx) berada di server yang sama:
# bawaannya sudah mempercayai loopback beserta jaringan lokal. Isi hanya bila
# proksinya di mesin lain, misalnya "203.0.113.10/32".
#
# Salah mengisi ini melumpuhkan seluruh pembatas laju: bila pengirim yang tidak
# berhak dipercaya mengisi kepala itu, setiap permintaan terhitung berasal dari
# alamat yang berbeda.
TRUSTED_PROXIES=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_DARI=
SMTP_NAMA=PPDB SMA IMTEK
