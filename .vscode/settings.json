{
  // ============================================================
  //  Setelan bersama proyek ini
  //  Setelan pribadi (tema, ukuran huruf) tidak ditaruh di sini.
  // ============================================================

  // Go, Node, dan psql pada komputer pembuat tidak berada di folder
  // sistem. Tanpa baris ini, terminal di dalam VS Code tidak mengenal
  // perintah go maupun npm, padahal keduanya ada.
  "terminal.integrated.env.osx": {
    "PATH": "${env:HOME}/.local/go/bin:${env:HOME}/.local/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/local/go/bin:/Applications/Postgres.app/Contents/Versions/17/bin:${env:PATH}"
  },

  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Backend Go: gofmt dijalankan ekstensi Go, bukan pemformat lain.
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "go.formatTool": "gofmt",
  "go.lintOnSave": "package",
  "go.vetOnSave": "package",

  // Dua baris terakhir pada blok ini yang membuat ekstensi Go dan ESLint
  // benar-benar jalan di komputer ini. Setelan terminal.integrated.env.osx
  // di atas hanya mengubah PATH terminal DI DALAM VS Code, sedangkan
  // ekstensinya mencari binernya di PATH proses VS Code, dan VS Code yang
  // dibuka dari Finder tidak mewarisi PATH dari profil shell. Tanpa
  // keduanya, ekstensi Go melaporkan "go not found" dan ESLint mati
  // diam-diam, padahal keduanya ada di ~/.local.
  //
  // Komputer yang memasang Go dan Node lewat Homebrew tidak memerlukannya,
  // karena /opt/homebrew/bin sudah dikenali aplikasi GUI di macOS. Dua baris
  // ini cukup dihapus bila jalurnya memang tidak ada.
  "go.goroot": "${env:HOME}/.local/go",
  "eslint.runtime": "${env:HOME}/.local/node/bin/node",

  // Frontend: Tailwind 4 menaruh temanya di globals.css, dan kelasnya
  // sering disusun dengan penggabungan tulisan. Dua setelan di bawah
  // membuat saran kelas tetap muncul di tempat-tempat itu.
  "tailwindCSS.experimental.classRegex": [
    ["className=\\{([^}]*)\\}", "[\"'`]([^\"'`]*)[\"'`]"],
    ["class(?:Name)?\\s*=\\s*[\"']([^\"']*)[\"']"]
  ],
  "tailwindCSS.includeLanguages": { "typescriptreact": "html" },
  "css.lint.unknownAtRules": "ignore",
  "editor.quickSuggestions": { "strings": "on" },

  "[typescript]": { "editor.defaultFormatter": "vscode.typescript-language-features" },
  "[typescriptreact]": { "editor.defaultFormatter": "vscode.typescript-language-features" },
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.workingDirectories": ["frontend"],

  // Folder yang isinya dihasilkan mesin dibuang dari pencarian, supaya
  // hasil pencarian tidak dipenuhi berkas bangunan.
  "search.exclude": {
    "frontend/.next": true,
    "frontend/node_modules": true,
    "frontend/out": true,
    "backend/data": true,
    "backend/server": true,
    "docs/data.js": true,
    "docs/demo.js": true,
    "legacy-php": true
  },
  "files.watcherExclude": {
    "**/frontend/.next/**": true,
    "**/frontend/node_modules/**": true,
    "**/backend/data/**": true
  },

  "files.associations": {
    "*.sql": "sql",
    "jalankan.command": "shellscript"
  },

  // Batas kolom yang dipakai kode proyek ini.
  "editor.rulers": [80, 100]
}
